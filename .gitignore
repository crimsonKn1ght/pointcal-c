# Data (never commit the 2.0 GB ModelNet40-C artifact).
# Exclude the contents rather than the directory itself, so the negation below
# can still take effect: git does not descend into an excluded directory.
data/*
!data/README.md

# Run outputs are scratch: `runs/` is regenerated by re-running a tier.
# Curated deliverables are copied into `results/` and ARE committed --
# see results/README.md for what belongs there.
runs/
*.npy

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Model weights cache
.cache/
checkpoints/
